{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "actions/publish/src/**/*.ts",
    "actions/publish/test/**/*.ts",
    "tools/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
