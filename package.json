{
  "name": "pixelwatch",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted visual-regression review for GitHub repositories.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run lint:workflows",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:workflows": "node tools/lint-workflows.ts",
    "tools:install": "node tools/install-lint-tools.ts",
    "schemas:types": "node packages/schemas/scripts/generate-types.ts",
    "schemas:viewer": "node packages/schemas/scripts/generate-viewer-validators.ts",
    "dev:compare": "node tools/pixelwatch-dev.ts compare",
    "test:simulation": "node tools/simulation/runner.ts",
    "build:action": "node tools/release/build-cli.ts",
    "dev:serve": "node tools/pixelwatch-dev.ts serve",
    "viewer:fixture": "node tools/viewer/fixture-cli.ts",
    "test:viewer": "node tools/viewer/runner.ts",
    "test:live": "node tools/live.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "fast-png": "8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
